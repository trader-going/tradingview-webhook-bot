//@version=6
strategy("GoingBot Webhook Example", overlay=true, precision=2, pyramiding=1,
     initial_capital=100000,
     commission_type=strategy.commission.percent, commission_value=0.2)

// GoingBot TradingView alert example.
// Alert message must be exactly:
// {{strategy.order.alert_message}}
//
// WARNING: This is a webhook test strategy. It alternates entry/close orders by bar_index.
// Do not connect it to a live alert until you replace longEntry/longClose with your real strategy logic.

gWebhook = "GoingBot Webhook"
webhookSecret = input.string("", "Webhook Secret", group=gWebhook)
exchangeName = input.string("BINANCE", "Exchange", options=["UPBIT", "BITHUMB", "BINANCE", "BYBIT", "OKX"], group=gWebhook)
symbolOverride = input.string("", "Symbol Override", group=gWebhook)
leverage = input.int(1, "Leverage", minval=1, maxval=125, group=gWebhook)
hedgeMode = input.bool(false, "Hedge Mode", group=gWebhook)
entryQtyStr = input.string("100USDT", "Entry Qty", group=gWebhook)
closeQtyStr = input.string("100%", "Close Qty", group=gWebhook)

gBacktest = "Backtest"
btQty = input.float(1, "Backtest Qty", minval=0.000001, group=gBacktest)
startTime = input.time(timestamp("01 Jan 2000 00:00 +0000"), "Start", group=gBacktest)
endTime = input.time(timestamp("01 Jan 2099 00:00 +0000"), "End", group=gBacktest)

inDate = time >= startTime and time <= endTime

json_bool(bool value) =>
    value ? "true" : "false"

payload_symbol() =>
    symbolOverride == "" ? syminfo.ticker : symbolOverride

build_msg(string action, string qtyStr, string orderId) =>
     '{"secret":"' + webhookSecret + '"' +
     ',"id":"' + orderId + '-' + str.tostring(time) + '"' +
     ',"action":"' + action + '"' +
     ',"exchange":"' + exchangeName + '"' +
     ',"symbol":"' + payload_symbol() + '"' +
     ',"price":"' + str.tostring(close, format.mintick) + '"' +
     ',"qty":"' + qtyStr + '"' +
     ',"leverage":' + str.tostring(leverage) +
     ',"hedgeMode":' + json_bool(hedgeMode) +
     ',"time":"' + str.tostring(time) + '"' +
     '}'

longEntry = inDate and bar_index % 2 == 0 and strategy.position_size == 0
longClose = inDate and bar_index % 2 == 1 and strategy.position_size > 0

if longEntry
    strategy.entry("L", strategy.long, qty=btQty, alert_message=build_msg("LONG_ENTRY", entryQtyStr, "L_ENTRY"))

if longClose
    strategy.close("L", qty=btQty, alert_message=build_msg("LONG_CLOSE", closeQtyStr, "L_CLOSE"))

// Short-side example. Uncomment when the strategy logic actually needs short orders.
// shortEntry = inDate and bar_index % 4 == 2 and strategy.position_size == 0
// shortClose = inDate and bar_index % 4 == 3 and strategy.position_size < 0
//
// if shortEntry
//     strategy.entry("S", strategy.short, qty=btQty, alert_message=build_msg("SHORT_ENTRY", entryQtyStr, "S_ENTRY"))
//
// if shortClose
//     strategy.close("S", qty=btQty, alert_message=build_msg("SHORT_CLOSE", closeQtyStr, "S_CLOSE"))
